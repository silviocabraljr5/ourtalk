Options -Indexes
DirectoryIndex index.html
AddType text/javascript .mjs
<FilesMatch "(?i)\.(sql|bak|zip|tar|gz|env|log)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?ourtalk\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://ourtalk.com.br%{REQUEST_URI} [R=301,L]
